# Supabase values used by the web app (safe to expose to the browser; RLS required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://toto-tad-cinema.vercel.app

# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# Never prefix it with NEXT_PUBLIC_. The web app does not need this key.

# Movie API
NEXT_PUBLIC_OPHIM_API_URL=https://ophim1.com
